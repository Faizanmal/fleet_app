FROM python:3.12-slim AS build
ENV VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:$PATH"
WORKDIR /build
RUN python -m venv "$VIRTUAL_ENV"
COPY pyproject.toml README.md ./
COPY apps/api/src ./apps/api/src
RUN pip install --no-cache-dir ".[observability]" "pytest==9.0.1"

FROM python:3.12-slim
ENV VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --system fleet && useradd --system --gid fleet --home-dir /app fleet
COPY --from=build /opt/venv /opt/venv
COPY apps/api/src ./apps/api/src
COPY apps/api/tests ./apps/api/tests
ENV PYTHONPATH=/app/apps/api/src
USER fleet
CMD ["python", "-m", "pytest", "apps/api/tests", "-ra"]
