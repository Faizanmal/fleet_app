# Copy to .env for local use. Never put real secrets in this file.
POSTGRES_PASSWORD=fleet_dev_only
FLEET_APP_PASSWORD=fleet_app_dev_only
FLEET_INGEST_PASSWORD=fleet_ingest_dev_only
DATABASE_URL=postgresql://fleet_app:fleet_app_dev_only@localhost:5432/fleet
INGEST_DATABASE_URL=postgresql://fleet_ingest:fleet_ingest_dev_only@localhost:5432/fleet
MIGRATION_DATABASE_URL=postgresql://fleet:fleet_dev_only@localhost:5432/fleet
COMPOSE_DATABASE_URL=postgresql://fleet_app:fleet_app_dev_only@db:5432/fleet
COMPOSE_INGEST_DATABASE_URL=postgresql://fleet_ingest:fleet_ingest_dev_only@db:5432/fleet
COMPOSE_MIGRATION_DATABASE_URL=postgresql://fleet:fleet_dev_only@db:5432/fleet
DEMO_AUTH_MODE=false
APP_ENV=development
ACTION_MODE=SANDBOX_SIMULATION
# Approved model provider is optional. No AI credentials are needed for setup.
MODEL_PROVIDER=
MODEL_NAME=
TOOL_MAX_CALLS=8
TOOL_MAX_ITEMS=100
POLICY_VERSION=policy-v1
APP_CLOCK=UTC
BUILD_VERSION=dev
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=rayda-fleet-api
# Optional OTLP/HTTP collector URL; telemetry remains local/no-export when empty.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
